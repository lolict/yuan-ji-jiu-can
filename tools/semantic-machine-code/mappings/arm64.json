    "ADD":  {"format": "DS", "opkey": "ADD_REG_SHIFT", "operands": "Rd, Rn, Rm", "description": "加法 Rd = Rn + Rm"},
    "SUB":  {"format": "DS", "opkey": "SUB_REG_SHIFT", "operands": "Rd, Rn, Rm", "description": "减法 Rd = Rn - Rm"},
    "AND":  {"format": "DS", "opkey": "AND_REG_SHIFT", "operands": "Rd, Rn, Rm", "description": "按位与"},
    "OR":   {"format": "DS", "opkey": "ORR_REG_SHIFT", "operands": "Rd, Rn, Rm", "description": "按位或"},
    "XOR":  {"format": "DS", "opkey": "EOR_REG_SHIFT", "operands": "Rd, Rn, Rm", "description": "按位异或"},
