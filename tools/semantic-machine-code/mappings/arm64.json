    "SUBI": {"format": "DI", "opkey": "SUB_IMM",       "operands": "Rd, Rn, #imm12", "description": "减立即数 Rd = Rn - imm12"},
    "LW":   {"format": "LSU", "opkey": "LDR_IMM_UOFFSET","operands": "Rt, imm12, Rn", "description": "加载32位字 Rt = *(Rn + imm12*4)"},
    "SW":   {"format": "LSU", "opkey": "STR_IMM_UOFFSET","operands": "Rt, imm12, Rn", "description": "存储32位字 *(Rn + imm12*4) = Rt"},
    "MOV":  {"format": "MOV_IMM", "opkey": "MOV_IMM",  "operands": "Rd, #imm16", "description": "MOV 立即数（MOVZ 别名）"},
