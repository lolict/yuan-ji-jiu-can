  "instructions": {
    "ADD":  {"format": "DS", "encoding": "0x8B000000 | (Rm<<16) | (Rn<<5) | Rd", "description": "加法（移位寄存器形式），Rd = Rn + Rm"},
    "SUB":  {"format": "DS", "encoding": "0xCB000000 | (Rm<<16) | (Rn<<5) | Rd", "description": "减法（移位寄存器形式），Rd = Rn - Rm"},
    "AND":  {"format": "DS", "encoding": "0x0A000000 | (Rm<<16) | (Rn<<5) | Rd", "description": "按位与（移位寄存器形式）"},
    "OR":   {"format": "DS", "encoding": "0x6A000000 | (Rm<<16) | (Rn<<5) | Rd", "description": "按位或（移位寄存器形式）"},
    "XOR":  {"format": "DS", "encoding": "0x4A000000 | (Rm<<16) | (Rn<<5) | Rd", "description": "按位异或（移位寄存器形式）"},
    "ADDI": {"format": "DI", "encoding": "0x91000000 | (shift<<22) | (imm12<<10) | (Rn<<5) | Rd", "description": "加立即数：Rd = Rn + imm12 (shift=00)"},
    "SUBI": {"format": "DI", "encoding": "0xD1000000 | (shift<<22) | (imm12<<10) | (Rn<<5) | Rd", "description": "减立即数：Rd = Rn - imm12"},
    "SLL":  {"format": "DS", "encoding": "UBFM/移位别名，Rd = Rn << shamt", "description": "逻辑左移，移位量0-63"},
    "SRL":  {"format": "DS", "encoding": "UBFM别名，Rd = Rn >> shamt", "description": "逻辑右移"},
    "SRA":  {"format": "DS", "encoding": "SBFM别名，Rd = Rn >> shamt（算术）", "description": "算术右移"},
    "LW":   {"format": "LSU", "encoding": "0xB9400000 | (imm12<<10) | (Rn<<5) | Rt", "description": "加载32位字：Rt = *(Rn + imm12*4)"},
    "SW":   {"format": "LSU", "encoding": "0xB9000000 | (imm12<<10) | (Rn<<5) | Rt", "description": "存储32位字：*(Rn + imm12*4) = Rt"},
    "MOV":  {"format": "MOV_IMM", "encoding": "0xD2800000 | (hw<<21) | (imm16<<5) | Rd", "description": "MOV 立即数加载（MOVZ 别名）"},
    "LUI":  {"format": "MOV_IMM", "encoding": "0xD2800000 | (1<<21) | (imm16<<5) | Rd", "description": "加载高位立即数（MOVZ xRd, #imm16, LSL #16）"},
    "JMP":  {"format": "B", "encoding": "0x14000000 | (imm26 & 0x3FFFFFF)", "description": "无条件跳转（PC相对）"},
    "BEQ":  {"format": "BC", "encoding": "0x54000000 | (imm19<<5) | 0b0000", "description": "相等跳转：cond=EQ (0000)"},
    "BNE":  {"format": "BC", "encoding": "0x54000000 | (imm19<<5) | 0b0001", "description": "不等跳转：cond=NE (0001)"}
