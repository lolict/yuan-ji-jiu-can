# 容器语言 · 游走器
# 读取表 · 呼唤字段 · 加法串联 · 不运行外部代码

# ======================================================
# 游走规则
# ======================================================

表( 游走引擎 ) {
  # 遇到 表( 名 ) { ... } 时:
  动作1: 把表整体记下来 · 名字作为容器放入"已修通砖块"
  动作2: 遍历表内每个字段
  动作3: 如果字段值以@开头 · 去呼唤对应的值
  动作4: 如果字段含"往后N格" · 做加法(往后移动)
  动作5: 折叠: 符号用完后新增层 · 不进位
}

表( 当前上下文 ) {
  正在走哪张表: 无
  公路终点: @公路系统.公路终点
  已呼唤的字段: 空
  可用符号数: @公路系统.公路终点 + 1   # 等于公路终点往后1格
}

# ======================================================
# 程序入口 · 运行"程序演示"
# ======================================================

表( 运行器 ) {
  起点: 表( 程序演示 )
  
  # 走步骤1
  步骤1: @程序演示.步骤1
  结果1: 格子3对应 @完整顺序.格子3
  
  # 走步骤2
  步骤2: @程序演示.步骤2
  结果2: 格子4对应 @完整顺序.格子4
  
  # 走步骤3: 加法
  步骤3: 从格子3 往后走4格
  结果3: 到达格子3往后4格 = 格子7
  
  # 步骤4: 验证
  步骤4: @完整顺序.格子7
  结果4: 格子3 + 格子4 = 格子7 ✓
  
  # 输出
  最终输出: 格子7 的口数 = @完整顺序.格子7 = 口口口口口口口口
}
