# 容器语言 · Container-Lang
# 作者: 刘楚恬和我
# 规则: 写表就是写程序 · 四种运算各管各的 · 不混用

# ======================================================
# 运算哲学(分工):
#   加法    -> 往后移动 · 管起点 · 管点状变化 · 管事件
#   减法    -> 往回移动 · 加法逆运算 · 管起点返还
#   乘法    -> 铺面积体积 · 管终点 · 管对称 · 管旋转 · 管频率
#   除法    -> 找回中心 · 乘法逆运算 · 管对称切片 · 管首尾
#
# 铁律:
#   起点只能用加/减呼唤(乘法锁死起点为0)
#   终点/对称只能用乘/除呼唤(加法管不了对称中心)
# ======================================================

# ======================================================
# 第1表: 完整数数顺序(公路)
# ======================================================

表( 完整顺序 ) {
  格子0  -> 口
  格子1  -> 口口
  格子2  -> 口口口
  格子3  -> 口口口口
  格子4  -> 口口口口口
  格子5  -> 口口口口口口
  格子6  -> 口口口口口口口
  格子7  -> 口口口口口口口口
  格子8  -> 口口口口口口口口口
  格子9  -> 口口口口口口口口口口
  格子10 -> 口口口口口口口口口口口
  格子11 -> 口口口口口口口口口口口口
  格子12 -> 口口口口口口口口口口口口口
  格子13 -> 口口口口口口口口口口口口口口
  格子14 -> 口口口口口口口口口口口口口口口
  格子15 -> 口口口口口口口口口口口口口口口口
}

# ======================================================
# 第2表: 加法(往后移动 · 管起点)
# ======================================================

表( 加法表 ) {
  # 加法的本质: 公路延伸 · 走到下一个格子
  往后0格 -> 原格子不动
  往后1格 -> 下一个格子
  往后2格 -> 下下一个格子

  # 加法例子: 从起点开始往后走
  格子0 往后3格 -> 格子3    # 从第1个格子往后走到第4个
  格子5 往后3格 -> 格子8    # 加法只走 · 不进位 · 无溢出
  格子9 往后1格 -> 格子10
  格子15 往后0格 -> 格子15
}

# ======================================================
# 第3表: 减法(往回移动 · 加法逆运算 · 管起点返还)
# ======================================================

表( 减法表 ) {
  # 减法的本质: 往回走 · 把起点还回去
  往回0格 -> 原格子不动
  往回1格 -> 上一个格子
  往回2格 -> 上上一个格子

  # 减法例子
  格子8 往回3格 -> 格子5    # 加法逆运算: 5往后3格=8 · 8往回3格=5
  格子15 往回1格 -> 格子14
  格子3 往回0格 -> 格子3

  # 铁律: 减法能回到起点 · 乘法做不到
  格子0 往回任何 -> 无定义   # 起点不能再往前 · 不是乘法那种锁死 · 是真的没有
}

# ======================================================
# 第4表: 乘法(铺面积 · 管终点 · 管对称)
# ======================================================

表( 乘法表 ) {
  # 乘法的本质: 不是往后走 · 是铺出一片面积
  # 乘法管的是"终点落在哪" · 管对称结构 · 管旋转对称

  # 乘法口诀: 铺N份
  格子0 铺 任何份 -> 格子0    # 铁律: 乘法锁死起点 · 让它管起点就永远不变
  格子1 铺 2份 -> 格子2      # 铺2份格子1的面积
  格子3 铺 2份 -> 格子6      # 格子3的面积铺2份
  格子3 铺 3份 -> 格子9      # 格子3的面积铺3份
  格子4 铺 2份 -> 格子8

  # 乘法管终点: 每次乘法的结果就是终点的位置
  格子2 铺 4份 -> 格子8      # 终点落在格子8

  # 乘法管对称: 铺出来的面积可以首尾对称
  格子3 铺 4份 -> 格子12     # 中心在格子6 · 对称分布
}

# ======================================================
# 第5表: 除法(找回中心 · 乘法逆运算 · 管首尾对称)
# ======================================================

表( 除法表 ) {
  # 除法的本质: 乘法铺出来的面积 · 除法把它收回来
  # 除法管对称切片 · 管首尾 · 管中心

  # 除法口诀: 把面积均分
  格子0 分成 任何份 -> 无定义   # 0无首尾 · 0无乘法逆 · 除法管不了起点
  格子6 分成 2份 -> 格子3      # 乘法逆: 3铺2份=6 · 6分成2份=3
  格子9 分成 3份 -> 格子3
  格子12 分成 4份 -> 格子3

  # 除法找中心: 把首尾对折 · 找到对称中心
  格子8 分成 2份 -> 格子4      # 首是格子1 · 尾是格子8 · 中心是格子4和格子5之间
  格子15 分成 3份 -> 格子5     # 三等分 · 每份格子5 · 对称分布

  # 铁律: 除法只能从已有的面积中找回起点 · 管不了起点本身
}

# ======================================================
# 第6表: 呼唤(取值)
# ======================================================

表( 取值规则 ) {
  # @表名.字段名 = 取那个格子的值
  @完整顺序.格子5 -> 口口口口口口
  @加法表.往后1格 -> 下一个格子

  # 呼唤另一个容器
  @完整顺序.格子0 -> 口
  @完整顺序.格子15 -> 口口口口口口口口口口口口口口口口
}

# ======================================================
# 第7表: 公路(容器之间的串联)
# ======================================================

表( 公路系统 ) {
  # 修到哪个砖块 = 哪一排格子可用
  公路终点 -> 格子9

  # 可用格子: 从格子0到公路终点
  可用格子 -> @完整顺序.格子0 到 @完整顺序.格子9

  # 公路延伸 = 加法
  公路终点 往后1格 -> 格子10
  公路终点 往后3格 -> 格子12
}

# ======================================================
# 第8表: 运算分流(铁律 · 不可混用)
# ======================================================

表( 运算分流 ) {
  # 规则1: 要移动起点 -> 用加法或减法
  需要移动起点: 用加法往后 · 或减法往回
  例子: 起点格子0 往后3格 -> 格子3(用加法)

  # 规则2: 要找终点 -> 用乘法或除法
  需要找终点: 用乘法铺到 · 或除法收回
  例子: 从格子3 铺到哪里能到达格子12 -> 铺4份(用乘法)

  # 规则3: 要找回起点(乘法锁死起点为0)
  起点为0时: 乘法永远给0 · 必须用加法才能移动起点
  例子: 格子0 铺 任何份 -> 格子0(锁死)
        格子0 往后3格 -> 格子3(加法解锁)

  # 规则4: 要找对称中心 -> 用除法
  需要对称: 把面积均分 · 找中心切片
  例子: 格子12 分成 3份 -> 每份格子4(对称)
}

# ======================================================
# 程序演示1: 加法管起点(格子3 + 格子4)
# ======================================================

表( 程序演示1 ) {
  步骤1: 格子3 是 口口口口
  步骤2: 格子4 是 口口口口口
  步骤3: 从格子3 往后4格             # 做加法(往后移动)
  步骤4: 到达格子7                   # 格子3 + 格子4 = 格子7
  结果: @完整顺序.格子7 -> 口口口口口口口口
  原理: 加法管起点 · 不管终点 · 只管往后走
}

# ======================================================
# 程序演示2: 减法管起点返还(格子7 - 格子4)
# ======================================================

表( 程序演示2 ) {
  步骤1: 格子7 是 口口口口口口口口
  步骤2: 要返还格子4的口数
  步骤3: 从格子7 往回4格             # 做减法(往回走)
  步骤4: 到达格子3                   # 格子7 - 格子4 = 格子3
  结果: @完整顺序.格子3 -> 口口口口
  原理: 减法是加法逆运算 · 把起点还回去
}

# ======================================================
# 程序演示3: 乘法管终点(格子3 铺 4份)
# ======================================================

表( 程序演示3 ) {
  步骤1: 格子3 是 口口口口
  步骤2: 做乘法: 格子3 铺 4份
  步骤3: 终点落在格子12              # 3铺4 = 12
  结果: @完整顺序.格子12 -> 口口口口口口口口口口口口口
  原理: 乘法管终点 · 铺出的面积到达的格子就是终点
  注意: 如果用乘法管起点(格子0) · 起点永远是0 · 不变
}

# ======================================================
# 程序演示4: 除法管对称中心(格子12 找中心)
# ======================================================

表( 程序演示4 ) {
  步骤1: 格子12 是 3铺4的结果
  步骤2: 做除法: 格子12 分成 4份
  步骤3: 每份回到格子3               # 12除4 = 3
  结果: @完整顺序.格子3 -> 口口口口
  原理: 除法找回乘法铺丢的起点 · 管对称切片 · 管首尾
  注意: 格子0不能分成任何份 · 因为起点无面积 · 0无乘法逆
}

# ======================================================
# 程序演示5: 运算叠加(先加后乘 · 先铺后除)
# ======================================================

表( 程序演示5 ) {
  # 加法铺路 · 乘法定界
  阶段1(加法): 从格子0 往后3格 -> 格子3    # 加法: 起点往后移
  阶段2(乘法): 格子3 铺 2份 -> 格子6      # 乘法: 铺面积找终点
  结果: 加法给了起点 · 乘法给了终点

  # 乘法铺面 · 除法收束
  阶段3(乘法): 格子4 铺 3份 -> 格子12     # 乘法: 铺大面积
  阶段4(除法): 格子12 分成 3份 -> 格子4    # 除法: 收回对称中心
  结果: 乘法铺了面 · 除法找回中心
}

# ======================================================
# 满全法5项裁判(每次运行程序前的检查)
# ======================================================

表( 裁判5项 ) {
  层号: 当前在第几层容器
  声母: 当前正在走哪个声母位置
  韵母: 正在遍历的韵母组合
  折叠: 遇到新情况是否新增层 · 不进位
  下一步: 跟规则走或裁决
}
