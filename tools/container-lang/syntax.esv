# 容器语言 · Container-Lang
# 作者: 刘楚恬和我
# 规则: 写表就是写程序 · 没有复杂语法 · 只有容器和地址

# ======================================================
# 唯一的语法: 表( 容器名 ) { 字段 -> 值 }
# ======================================================

# 数字: 只讲先后顺序 · 没有取值符号
# 加法: 往后移动 · 不进位
# 呼唤: @容器名.字段名 = 远程取值
# 公路: 砖块之间串联 · 加法连接

# 第1表: 完整数数顺序(公路)
表( 完整顺序 ) {
  格子0  -> 口                             # 第1个位置
  格子1  -> 口口                            # 第2个位置
  格子2  -> 口口口                           # 第3个位置
  格子3  -> 口口口口                          # 第4个位置
  格子4  -> 口口口口口                         # 第5个位置
  格子5  -> 口口口口口口                        # 第6个位置
  格子6  -> 口口口口口口口                       # 第7个位置
  格子7  -> 口口口口口口口口                      # 第8个位置
  格子8  -> 口口口口口口口口口                     # 第9个位置
  格子9  -> 口口口口口口口口口口                    # 第10个位置
  格子10 -> 口口口口口口口口口口口                   # 第11个位置
  格子11 -> 口口口口口口口口口口口口                  # 第12个位置
  格子12 -> 口口口口口口口口口口口口口                 # 第13个位置
  格子13 -> 口口口口口口口口口口口口口口                # 第14个位置
  格子14 -> 口口口口口口口口口口口口口口口               # 第15个位置
  格子15 -> 口口口口口口口口口口口口口口口口              # 第16个位置
}

# 第2表: 加法(就是往后移动)
表( 加法表 ) {
  # 格式: 从格子N 往后走M格 到达格子X
  往后0格 -> 原格子不动
  往后1格 -> 下一个格子
  往后2格 -> 下下一个格子
  
  # 具体例子
  格子5 往后3格 -> 格子8
  格子9 往后1格 -> 格子10    # 加法只走 · 不进位
  格子15 往后0格 -> 格子15
}

# 第3表: 呼唤(取值)
表( 取值规则 ) {
  # @表名.字段名 = 取那个格子的值
  @完整顺序.格子5 -> 口口口口口口
  @加法表.往后1格 -> 下一个格子
  
  # 呼唤另一个容器
  @完整顺序.格子0 -> 口
  @完整顺序.格子15 -> 口口口口口口口口口口口口口口口口
}

# 第4表: 公路(容器之间的串联)
表( 公路系统 ) {
  # 修到哪个砖块 = 哪一排格子可用
  公路终点 -> 格子9          # 目前修到第10个位置
  
  # 可用格子: 从格子0到公路终点
  可用格子 -> @完整顺序.格子0 到 @完整顺序.格子9
  
  # 公路延伸 = 加法
  公路终点 往后1格 -> 格子10    # 延伸到下一格
  公路终点 往后3格 -> 格子12    # 延伸到往后3格
}

# ======================================================
# 程序演示: 计算"格子3 + 格子4"
# ======================================================

表( 程序演示 ) {
  步骤1: 格子3 是 口口口口          # 取第1个操作数
  步骤2: 格子4 是 口口口口口          # 取第2个操作数
  步骤3: 从格子3 往后4格             # 做加法(往后移动)
  步骤4: 到达格子7                   # 格子3 + 格子4 = 格子7
  结果: @完整顺序.格子7 -> 口口口口口口口口     # 验证
}

# ======================================================
# 程序演示: 修公路
# ======================================================

表( 修公路演示 ) {
  起点: @公路系统.公路终点          # 当前修到格子9
  修1格: 起点 往后1格 -> 格子10      # 修一格
  修3格: 起点 往后3格 -> 格子12      # 修三格
  新终点: @公路系统.公路终点 往后3格 -> 格子12
  
  # 修到后 · 可用范围扩大
  原可用: @公路系统.可用格子         # 格子0-格子9
  新可用: @完整顺序.格子0 到 @完整顺序.格子12  # 格子0-格子12
}

# ======================================================
# 满全法5项裁判(每次运行程序前的检查)
# ======================================================

表( 裁判5项 ) {
  层号: 当前在第几层容器            # 层号
  声母: 当前正在走哪个声母位置        # 遍历声母队列
  韵母: 正在遍历的韵母组合           # 遍历韵母
  折叠: 遇到新情况是否新增层          # 符号用完就折叠 · 不进位
  下一步: 跟规则走或裁决             # 裁·判·审·决
}
