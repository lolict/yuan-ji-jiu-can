# FQM 容器定义文件
# 这是我们自己的格式，不依赖任何外部语言语法

# 声母容器（23个）
袋.声母.容=b,p,m,f,d,t,n,l,g,k,h,j,q,x,zh,ch,sh,r,z,c,s,y,w
袋.声母.进制=23
袋.声母.极性=1

# 韵母容器（24个）
袋.韵母.容=a,o,e,i,u,v,ai,ei,ui,ao,ou,iu,ie,ve,er,an,en,in,un,vn,ang,eng,ing,ong
袋.韵母.进制=24
袋.韵母.极性=0

# 声调容器（4个）
袋.声调.容=1,2,3,4
袋.声调.进制=4
袋.声调.极性=1

# 跨容器链接：声母→韵母
袋.声母.引.韵母=b→a,p→o,m→e,f→i,d→u,t→v

# 近义词表
近.分=份,纷,芬
近.家=嘉,佳,加
近.园=元,圆,原
近.召=招,沼,照

# 全局偏移
偏=0x00
