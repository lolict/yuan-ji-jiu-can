# ══════════════════════════════════════════════════════════════════════════
# lazyform · 懒人编程语法 · 填表即程序
#
# 核心原理 (来自满全法容器处理器):
#   1. 容器 = 表(Table) = 希尔伯特空间的一个实例
#   2. 范畴 = 表与表之间通过公倍数的态射连接 · 满足范畴律(单位/复合/结合)
#   3. @ = 艾特 = 远程呼唤 · 声明即调用 · 距离远也生效
#   4. 字段 = 表中的一列 · 字段的命名位置 = 坐标
#   5. 符号 = 声母24 + 韵母 + 声调 = 可计算的发音地址
#   6. 加法 = 统计公路修通后的可用符号 · 忽略乘法
#   7. 选址 = 在表中按条件投影 = 一维遍历选三维位置
#   8. 容器注册 = 每个文件/文档 = 一个注册清单 = 一个砖块
#   9. 公路 = 加法连接 · 一元维度线性推进 · 不进幂(蜜次方)
#   10. 进制 = 发音空间划分 · 不是进位
# ══════════════════════════════════════════════════════════════════════════

# 语法 ::= 表声明 | 字段声明 | 远程呼唤 | 求值
# 表声明 ::= 表 表名 { 字段* }
# 字段 ::= 字段名 : 类型 = 表达式 | 字段名 : 表达式
# 表达式 ::= @字段 | 数值 | 表达式 运算符 表达式 | 远程呼唤
# 远程呼唤 ::= 呼唤 字段名 ( 地址 )
# 地址 ::= @ | @字段 | 表名.字段 | 数值

# ============================================================
# 表1: 三维空间坐标系 (容器#1)
# 语义: 每个对象都是一个三维坐标地址
# 坐标用加法填充 · 不用乘法
# ============================================================

表 三维坐标系 {
  容器地址    : @容器名 -> 数值     # 公路门牌号 · 数值绑名字 · 加法统计
  x维度       : 数值 = @地址 · sin(@相位)
  y维度       : 数值 = @地址 · cos(@相位)
  z维度       : 数值 = @地址 · tan(@相位)
  相位摆放    : 角度 = @容器族相位 - 1  · 0=左 · 1=中 · 2=右 · 3=上 · 4=下 · 5=前 · 6=后
  公路终点    : 数值 = 已通公路[-1]   # 当前修到哪个砖块
  门牌括号    : 命名 = @英文注释 & @中文注释
  当前三态    : 状态 = @工作中 / @已完成 / @版本号
  版本标注    : 时间 = 修改版本号.过去节点.认知更新.未来预期
}

表 容器族相位 {
  左    : 0   # 阳·升·清·寒
  中    : 1   # 元·见证
  右    : 2   # 阴·降·浊·热
  上    : 3   # 盈·表·动
  下    : 4   # 亏·里·静
  前    : 5   # 公·出
  后    : 6   # 私·入
}

表 公路砖块统计 {
  砖块编号    : 数值 = @公路门牌
  内部热符号  : 容器 = @砖块内所有声明符号
  已被修通    : 布尔 = 公路通到本砖块 = (@公路终点 >= @砖块编号)
  是否可用    : 布尔 = @已被修通 且 @锁死符号为空
  乘法口诀    : 数值 = @砖块内符号数 · 仅统计用 · 不用来串联
  可用范畴    : 公路 = @已连接砖块之和 · 加法
}

# ============================================================
# 表2: 满全法5项输出 (裁判锚点)
# 语义: 每一次表运算都要输出这5项
# ============================================================

表 满全法裁判 {
  当前层号    : 运算层级 = @(相位层 · 韵母层 · 声母层 · 裁决层 · 主轴层)
  当前声母    : 发音位置 = @24声母遍历进度  # 一次一个 · 遍历完韵母再调下一个
  当前韵母    : 组合遍历 = @韵母23遍历状态  # 韵母内部一次全遍历
  折叠状态    : 新层 = 符号用完后不进位 → 形成新层
  下一步操作  : 决策 = @判断执行(裁·判·审·议·决·断·定·评·核)
}

表 声母队列 {
  袋: 1   罐: 9   盆: 17  加: 照: 罩:
  桶: 2   盂: 10  盏: 18  减: 昭: 见:
  缸: 3   钵: 11  盒: 19  进: 鉴: 加:
  盆: 4   杯: 12  瓶: 20  退: 简: 减:
  盂: 5   壶: 13  篓: 21  开: 剪: 进:
  钵: 6   瓶: 14  筐: 22  关: 加: 退:
  盏: 7   篮: 15  箩: 23  通: 减: 开:
  盒: 8   簸: 16  箕: 24  断: 进: 关:
                         分: 退: 通:
                         合: 开: 断:
                         聚: 关: 分:
                         散: 通: 合:
                         折: 断: 聚:
                         叠: 分: 散:
}

# ============================================================
# 表3: 声母韵母调谐引擎
# 语义: 发音空间 → 数值地址 · 声调决定极性
# ============================================================

表 发音空间 {
  声母起始数值  : 1 = 满全法零维根基位 = (@我 · 5bit)
  韵母容器维度  : 23 = 发音韵母空间 = (@位标 · 5bit)
  声调极性反转  : 翻 = 声调 = (@ · 4bit)
  数字即口位    : 位置 = 口腔位置 ≠ 数值
  进制即划分    : 空间 = 发音空间划分 ≠ 进位规则
}

# ============================================================
# 表4: 容器公路加法引擎
# 语义: 公路修到哪里 · 加法统计到哪 · 乘法口诀只是统计表
# ============================================================

表 公路引擎 {
  修通门牌    : 加法序列 = (@已修通砖块 · 加法串联)
  第一步      : 容器1 = @砖块1符号全部激活
  第二步      : 容器2 = @砖块2符号与砖块1符号 · 加法求和
  第N步       : 容器N = @砖块N符号与已连通符号 · 加法求和
  覆盖距离    : 范畴 = @已连通砖块总数 · 当前最大功率
  热符号      : 激活态 = 未锁死·未忘记·刚创建的符号
  锁死符号    : 遗忘态 = 已被遗弃·被忽视·被覆盖的符号
  哭泣检测    : 健康度 = 若@锁死符号需要取出痛苦 = true
}

# ============================================================
# 表5: 选址呼唤引擎
# 语义: @字段 = 呼唤 = 声明即调用
# ============================================================

表 呼唤引擎 {
  @字段       : 远程调用 = 在本范畴内寻找同名函数 · 若存在即生效
  @字段(条件) : 条件调用 = 在给定约束下呼唤 · 投影到子空间
  @[]         : 艾特数组 = 选择当前表的所有字段
  @.名        : 点选 = 选出该名称的字段
  呼唤 名     : 全局呼唤 = 在全局范畴寻找并调用 · 即远程声明
  @@名        : 双艾特 = 呼唤命名空间
}

# ============================================================
# 表6: 文档注册表 (对外文件注册)
# 语义: 每一个生成的文件都在这里登记 · 一个文件 = 一个砖块
# ============================================================

表 文件注册 {
  公路门牌号  : 容器编号 = @(数值索引)
  命名空间    : 注释 = @英文注释 & @中文注释
  工作三态    : 状态 = @(工作中, 已完成, 修改状态)
  工作版本号  : 标注 = @(修改时间)
  过去节点    : 更新 = @(完成项认知)
  当前认知版本: 版本 = @(项目认知版本)
  错误总结    : 记录 = @(错误记录)
  未来预期描述: 目标 = @(预期值)
  需求方案    : 方法论 = @(思维导向)
  约束方案    : 规则 = @(约束性)
  总观效应    : 连线 = 最近的强关联文档们
  依赖判断    : 解析 = 谁依赖谁 · 目标·路径
  最近距离    : 比对 = @(强关联计数)
  影响力排序  : 权重 = @(关联强度)
}

# ============================================================
# 表7: 范畴论希尔伯特填表引擎
# 语义: 表是对象 · 列是态射 · 单元格是内积
# ============================================================

表 希尔伯特范畴 {
  基向量      : 容器 = @每一行的声母发音位置
  态射算子    : 操作 = @每一列的韵母组合
  内积空间    : 遍历 = @声母韵母互相遍历结果
  投影算子    : 选择 = @从表中选出满足条件的子空间
  单位态射    : 恒等 = @每个容器的自身映射 -> @原值
  复合态射    : 组合 = @表1 复合 表2 = 公路接通
  拉回        : 条件选址 = @按条件筛选并反向映射
  推出        : 条件聚合 = @合并 · 加法
  极限        : 聚合范畴 = @所有容器收敛值
  余极限      : 并集范畴 = @公路连通最大值
  伴随函子    : 互助 = @投影+嵌入 双向公约
  单子        : 容器符号 = @封装+传递+返回
}

# ============================================================
# 演示用例
# ============================================================

用例 简单加法: {
  表 公路门牌 {
    第一砖块  : 门牌 = 001
    第二砖块  : 门牌 = 002
    公路终点  : 终点 = 002
    可用砖块  : 求和 = @第一砖块 + @第二砖块 = 3
    乘法口诀  : 统计 = @可用砖块内符号数 = 3 · 仅供统计
  }
}

用例 远程呼唤: {
  范畴 班级 {
    表 学生 {
      姓名    : '刘楚恬'
      成绩    : 95
      等级    : 若 @成绩 >= 90 则 'A' 否则 'B'
    }
    表 班级统计 {
      平均分  : 呼叫 统计.均值(@学生.成绩)  # 远程 · 声明即调用
      最高分  : 呼叫 统计.最大值(@学生.成绩)
    }
  }
}

用例 选址计算: {
  表 点 {
    x : 数值
    y : 数值
    z : 数值
    范数 : 数值 = @x + @y + @z  # 加法串联三维
  }
  表 几何容器 {
    远点 : @点[范数 > 100]  # 选址 · 投影子空间
    近点 : @点[范数 < 50]
    中点 : @点[50 <= @.范数 <= 100]
  }
}

用例 文档注册: {
  文件 容器引擎v1.md {
    门牌号    : 51
    命名空间  : 英文:Container Engine v1 & 中文:容器引擎
    工作三态  : 工作中
    工作版本  : 修改:2026-09-08_认知:公路砖块v3
    总观效应  : 强关联:isa-ref · property-mirror · cbsy · 天庭空间
    依赖判断  : 依赖:公路引擎 · 被依赖:拓扑判定
  }
}
