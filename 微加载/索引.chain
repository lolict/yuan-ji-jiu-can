gttx://索引|文档.docs.LOGICAL_ORG_RULE_TREE.md|24|D65FAAB49B71B572|pub struct RuleNode {
gttx://索引|文档.docs.LOGICAL_ORG_RULE_TREE.md|25|0E41B73087B6A331|pub rule_id: u64,
gttx://索引|文档.docs.LOGICAL_ORG_RULE_TREE.md|26|6568D096AEB848CC|pub cause_code: u64,       // 前因编码
gttx://索引|文档.docs.LOGICAL_ORG_RULE_TREE.md|27|FA0CE20C0F0958FE|pub effect_code: u64,      // 后果编码
